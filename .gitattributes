# Detecta texto automaticamente e normaliza no repositório
* text=auto

# Scripts Unix/Linux sempre com LF
*.sh text eol=lf
mvnw text eol=lf
gradlew text eol=lf

# Scripts Windows sempre com CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
mvnw.cmd text eol=crlf
gradlew.bat text eol=crlf

# Arquivos comuns do projeto com LF
*.java text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
Dockerfile text eol=lf
*.dockerfile text eol=lf

# Binários: sem diff textual
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.jar binary
*.war binary
*.zip binary
*.gz binary
*.tar binary
*.7z binary
